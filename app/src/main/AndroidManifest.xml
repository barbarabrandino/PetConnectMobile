<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PetConnect">

        <!-- Tela inicial -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login e Cadastro -->
        <activity android:name=".Login" android:exported="false" />
        <activity android:name=".TelaCadastro" android:exported="false" />
        <activity android:name=".TelaCadastroOng" android:exported="false" />

        <!-- Adotante -->
        <activity android:name=".TelaHome" android:exported="false" />
        <activity android:name=".Favoritos" android:exported="false" />
        <activity android:name=".MinhasSolicitacoes" android:exported="false" />
        <activity android:name=".Configuracoes" android:exported="false" />
        <activity android:name=".InteresseAdocaoActivity" android:exported="false" />
        <activity android:name=".Sobre" android:exported="false" />
        <activity android:name=".TermosDeUso" android:exported="false" />
        <activity android:name=".PoliticaPrivacidade" android:exported="false" />
        <activity android:name=".AlterarSenha" android:exported="false" />
        <activity android:name=".CadastroAnimalActivity" android:exported="false" />

        <!-- ONG -->
        <activity android:name=".DashboardOng" android:exported="false" />
        <activity android:name=".Solicitacoes" android:exported="false" />

    </application>

</manifest>
