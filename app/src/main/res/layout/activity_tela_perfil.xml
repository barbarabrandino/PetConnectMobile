<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ── FOTO HERO ── -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="340dp">

                <ImageView
                    android:id="@+id/ivPerfilFoto"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_cat_placeholder"/>

                <!-- Gradiente inferior -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:layout_gravity="bottom"
                    android:background="@drawable/gradient_foto_bottom"/>

                <!-- Botão voltar -->
                <ImageView
                    android:id="@+id/ivVoltar"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_margin="16dp"
                    android:layout_marginTop="40dp"
                    android:background="#80000000"
                    android:padding="10dp"
                    android:src="@drawable/ic_arrow_back"
                    android:tint="@color/white"
                    android:contentDescription="Voltar"/>

                <!-- Nome e raça sobre a foto -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:paddingBottom="20dp">

                    <TextView
                        android:id="@+id/tvPerfilNome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:fontFamily="@font/albert_sans_light"
                        android:text="Nome do Animal"/>

                    <TextView
                        android:id="@+id/tvPerfilRaca"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="#CCFFFFFF"
                        android:fontFamily="@font/albert_sans_light"
                        android:layout_marginTop="4dp"
                        android:text="Raça"/>

                </LinearLayout>
            </FrameLayout>

            <!-- ── CONTEÚDO ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Tags vacinado / castrado -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:id="@+id/tagPerfilVacinado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/tag_background"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="Vacinado"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/albert_sans_light"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/tagPerfilCastrado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/tag_background"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp"
                        android:text="Castrado"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/albert_sans_light"
                        android:layout_marginStart="8dp"
                        android:visibility="gone"/>

                </LinearLayout>

                <!-- Cards Idade / Porte / Sexo -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="24dp">

                    <!-- Idade -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:background="@color/verdebb"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎂"
                            android:textSize="20sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Idade"
                            android:textSize="11sp"
                            android:textColor="@color/cinza"
                            android:fontFamily="@font/albert_sans_light"
                            android:layout_marginTop="4dp"/>

                        <TextView
                            android:id="@+id/tvPerfilIdade"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:fontFamily="@font/albert_sans_light"
                            android:layout_marginTop="2dp"/>

                    </LinearLayout>

                    <View android:layout_width="6dp" android:layout_height="0dp"/>

                    <!-- Porte -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:background="@color/verdebb"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📏"
                            android:textSize="20sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Porte"
                            android:textSize="11sp"
                            android:textColor="@color/cinza"
                            android:fontFamily="@font/albert_sans_light"
                            android:layout_marginTop="4dp"/>

                        <TextView
                            android:id="@+id/tvPerfilTamanho"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:fontFamily="@font/albert_sans_light"
                            android:layout_marginTop="2dp"/>

                    </LinearLayout>

                    <View android:layout_width="6dp" android:layout_height="0dp"/>

                    <!-- Sexo -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center_horizontal"
                        android:background="@color/verdebb"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🐾"
                            android:textSize="20sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sexo"
                            android:textSize="11sp"
                            android:textColor="@color/cinza"
                            android:fontFamily="@font/albert_sans_light"
                            android:layout_marginTop="4dp"/>

                        <TextView
                            android:id="@+id/tvPerfilSexo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:fontFamily="@font/albert_sans_light"
                            android:layout_marginTop="2dp"/>

                    </LinearLayout>

                </LinearLayout>

                <!-- Divisor -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E8E8E8"
                    android:layout_marginBottom="20dp"/>

                <!-- Sobre -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sobre"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:fontFamily="@font/albert_sans_light"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:id="@+id/tvPerfilDescricao"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="@color/cinza"
                    android:fontFamily="@font/albert_sans_light"
                    android:lineSpacingMultiplier="1.6"
                    android:text="Descrição do animal"/>

                <!-- Divisor -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#E8E8E8"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="20dp"/>

                <!-- Responsável -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Responsável"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:fontFamily="@font/albert_sans_light"
                    android:layout_marginBottom="10dp"/>

                <!-- Card ONG -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@color/verdebb"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🏠"
                        android:textSize="24sp"
                        android:layout_marginEnd="12dp"/>

                    <TextView
                        android:id="@+id/tvPerfilAbrigo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:fontFamily="@font/albert_sans_light"
                        android:text="ONG: —"/>

                </LinearLayout>

                <!-- Botão adotar -->
                <Button
                    android:id="@+id/btnSolicitar"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginBottom="8dp"
                    android:backgroundTint="@color/verdebtn"
                    android:text="Quero Adotar!"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/albert_sans_light"
                    android:textColor="@color/white"/>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</LinearLayout>