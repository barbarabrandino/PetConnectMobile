<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:layout_marginHorizontal="2dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F1FAF1">

        <!-- Cabeçalho -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp"
            android:background="#E8F5E9">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="🐾"
                android:textSize="18sp"
                android:gravity="center"
                android:background="@drawable/circle_white_bg"
                android:layout_marginEnd="12dp"/>

            <TextView
                android:id="@+id/tvNomeAnimal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#1B5E20"
                android:fontFamily="@font/albert_sans_light"/>

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#C8E6C9"/>

        <!-- Corpo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp">

            <!-- Solicitante -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👤"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tvNomeOng"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textColor="#2E7D32"
                    android:fontFamily="@font/albert_sans_light"/>

            </LinearLayout>

            <!-- Data -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📅"
                    android:textSize="14sp"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tvData"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#388E3C"
                    android:fontFamily="@font/albert_sans_light"/>

            </LinearLayout>

            <!-- Badge status -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/albert_sans_light"
                android:background="@drawable/badge_status_bg"
                android:paddingHorizontal="14dp"
                android:paddingVertical="5dp"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>

        <!-- Botão Ver Detalhes -->
        <Button
            android:id="@+id/btnVerDetalhes"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginHorizontal="18dp"
            android:layout_marginBottom="10dp"
            android:backgroundTint="@color/verdebtn"
            android:text="@string/ver_detalhes"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/albert_sans_light"
            android:stateListAnimator="@null"
            style="@style/Widget.MaterialComponents.Button"/>

        <!-- Botões Aprovar / Recusar — visíveis só quando "Em análise" -->
        <LinearLayout
            android:id="@+id/layoutAcoes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginHorizontal="18dp"
            android:layout_marginBottom="18dp"
            android:weightSum="2">

            <Button
                android:id="@+id/btnAprovar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#2E7D32"
                android:text="✔ Aprovar"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/albert_sans_light"
                android:stateListAnimator="@null"
                style="@style/Widget.MaterialComponents.Button"/>

            <Button
                android:id="@+id/btnRecusar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="#C62828"
                android:text="✘ Recusar"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/albert_sans_light"
                android:stateListAnimator="@null"
                style="@style/Widget.MaterialComponents.Button"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>