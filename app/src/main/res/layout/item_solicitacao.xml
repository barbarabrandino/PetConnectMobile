<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="20dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:background="@color/verdebb">

        <!-- Nome do animal -->
        <TextView
            android:id="@+id/tvNomeAnimal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:fontFamily="@font/albert_sans_light"/>

        <!-- Nome da ONG -->
        <TextView
            android:id="@+id/tvNomeOng"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textColor="@color/cinza"
            android:fontFamily="@font/albert_sans_light"
            android:layout_marginTop="10dp"/>

        <!-- Data -->
        <TextView
            android:id="@+id/tvData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/cinza"
            android:fontFamily="@font/albert_sans_light"
            android:layout_marginTop="4dp"/>

        <!-- Status -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/albert_sans_light"
            android:layout_marginTop="12dp"/>

        <!-- Botão Ver Detalhes -->
        <Button
            android:id="@+id/btnVerDetalhes"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/verdebtn"
            android:text="@string/ver_detalhes"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/albert_sans_light"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>
