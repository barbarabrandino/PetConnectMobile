<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Título -->

        <EditText
            android:id="@+id/etPesquisar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E0FFED"
            android:fontFamily="@font/albert_sans_light"
            android:hint="Pesquisar pet"
            android:padding="12dp" />

        <TextView
            android:id="@+id/txtTituloHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Animais disponíveis 🐾"
            android:textSize="26sp"
            android:textStyle="bold"
            android:fontFamily="@font/albert_sans_light"
            android:textColor="@color/black"
            android:layout_marginBottom="20dp"/>

        <!-- Pesquisa -->

        <!-- CARD 1 -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#E0FFED">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/ic_launcher"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <Button
                        android:id="@+id/btnDetalhesThor"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="#498933"
                        android:text="Ver detalhes"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Thor"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/albert_sans_light"
                        android:textColor="@color/black"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2 anos • Porte Médio"
                        android:textSize="16sp"
                        android:textColor="#555555"
                        android:fontFamily="@font/albert_sans_light"
                        android:layout_marginTop="6dp"/>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- CARD 2 -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            >

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/ic_launcher"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#E0FFED">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Luna"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/albert_sans_light"
                        android:textColor="@color/black"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 ano • Pequeno Porte"
                        android:textSize="16sp"
                        android:textColor="#555555"
                        android:fontFamily="@font/albert_sans_light"
                        android:layout_marginTop="6dp"/>

                    <Button
                        android:id="@+id/btnDetalhesLuna"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="#498933"
                        android:text="Ver detalhes"
                        android:textStyle="bold"
                        android:textSize="18sp"/>

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>

</ScrollView>