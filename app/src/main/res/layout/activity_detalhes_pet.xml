<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- FOTO -->

        <ImageView
            android:id="@+id/imgPet"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:scaleType="centerCrop"
            android:src="@drawable/thor"/>

        <!-- CONTEÚDO -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Nome -->

            <TextView
                android:id="@+id/txtNomePet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thor"
                android:textSize="32sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textColor="@color/black"/>

            <!-- Informações -->

            <TextView
                android:id="@+id/txtInfoPet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 anos • Porte Médio • Macho"
                android:textSize="18sp"
                android:textColor="#555555"
                android:fontFamily="monospace"
                android:layout_marginTop="8dp"/>

            <!-- Status -->

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vacinado • Castrado"
                android:textSize="17sp"
                android:textColor="#498933"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginTop="14dp"/>

            <!-- Sobre -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sobre"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:fontFamily="monospace"
                android:layout_marginTop="30dp"/>

            <TextView
                android:id="@+id/txtDescricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Thor é um cachorro extremamente dócil, brincalhão e carinhoso. Foi resgatado por uma ONG parceira e atualmente busca um novo lar cheio de amor e cuidado."
                android:textSize="18sp"
                android:textColor="@color/black"
                android:fontFamily="monospace"
                android:lineSpacingExtra="5dp"
                android:layout_marginTop="12dp"/>

            <!-- ONG -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ONG Responsável"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:fontFamily="monospace"
                android:layout_marginTop="30dp"/>

            <TextView
                android:id="@+id/txtOng"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ONG Amigos de Patas"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:fontFamily="monospace"
                android:layout_marginTop="12dp"/>

            <!-- Botão -->

            <Button
                android:id="@+id/btnAdotar"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="40dp"
                android:backgroundTint="#498933"
                android:text="Tenho Interesse"
                android:textSize="20sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>