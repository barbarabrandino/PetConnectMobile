<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Solicitações Recebidas"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:fontFamily="@font/albert_sans_light"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:id="@+id/tvVazio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Nenhuma solicitação recebida ainda."
            android:textSize="16sp"
            android:textColor="@color/cinza"
            android:fontFamily="@font/albert_sans_light"
            android:visibility="gone"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSolicitacoes"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="8dp"/>

    </LinearLayout>

    <!-- BOTTOM NAV DA ONG — 3 itens -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="@color/white"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout android:id="@+id/navInicio"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center"
            android:orientation="vertical" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/ic_nav_home" android:tint="@color/text_muted"
                android:contentDescription="Início"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="Início"
                android:textColor="@color/text_muted" android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/navSolicitacoes"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center"
            android:orientation="vertical" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_agenda"
                android:tint="@color/teal_primary"
                android:contentDescription="Solicitações"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="Pedidos"
                android:textColor="@color/teal_primary" android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout android:id="@+id/navConfiguracoes"
            android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:gravity="center"
            android:orientation="vertical" android:clickable="true" android:focusable="true">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_manage" android:tint="@color/text_muted"
                android:contentDescription="Configurações"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:text="Config."
                android:textColor="@color/text_muted" android:textSize="11sp"/>
        </LinearLayout>

    </LinearLayout>
</LinearLayout>