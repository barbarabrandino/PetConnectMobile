<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:padding="23dp">

        <!-- Título -->

        <TextView
            android:id="@+id/txtTituloSobre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sobre_o_petconnect"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:fontFamily="@font/albert_sans_light"
            android:layout_marginBottom="20dp"/>

        <!-- Descrição -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/verdebtn"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/verdebb">

            <TextView
                android:id="@+id/txtDescricaoProjeto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="13dp"
                android:textAlignment="viewStart"
                android:gravity="start"
                android:text="@string/descricao_petconnect"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:justificationMode="inter_word"
                android:fontFamily="@font/albert_sans_light"
                android:lineSpacingExtra="6dp"/>

        </com.google.android.material.card.MaterialCardView>

        <!-- Objetivos -->


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/objetivos"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:fontFamily="@font/albert_sans_light"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:strokeColor="@color/verdebtn"
            app:cardBackgroundColor="@color/verdebb">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="@string/descricao_objetivos"
                android:textSize="17sp"
                android:textColor="@color/black"
                android:fontFamily="@font/albert_sans_light"
                android:lineSpacingExtra="5dp"/>

        </com.google.android.material.card.MaterialCardView>
        <!-- Tecnologias -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tecnologias"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:fontFamily="@font/albert_sans_light"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/verdebtn"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/verdebb">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/descricao_tecnologias"
                android:textSize="17sp"
                android:padding="18dp"
                android:textColor="@color/black"
                android:fontFamily="@font/albert_sans_light"
                android:lineSpacingExtra="5dp"/>
        </com.google.android.material.card.MaterialCardView>
        <!-- Equipe -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/equipe"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:fontFamily="@font/albert_sans_light"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="12dp"/>
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/verdebtn"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/verdebb">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/descricao_integrantes"
                android:textSize="17sp"
                android:padding="18dp"
                android:textAlignment="viewStart"
                android:gravity="start"
                android:justificationMode="inter_word"
                android:textColor="@color/black"
                android:fontFamily="@font/albert_sans_light"
                android:lineSpacingExtra="5dp"/>
            </com.google.android.material.card.MaterialCardView>
        <Button
            android:id="@+id/btnVoltar"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:layout_marginTop="40dp"
            android:backgroundTint="#498933"
            android:fontFamily="@font/albert_sans_light"
            android:text="@string/voltar"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- Botão -->

    </LinearLayout>

</ScrollView>