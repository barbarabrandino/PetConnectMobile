<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cadastro de ONG"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginBottom="16dp"
            android:fontFamily="sans-serif"/>

        <!-- Nome da ONG -->
        <EditText
            android:id="@+id/etNomeOng"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#E0FFED"
            android:fontFamily="sans-serif-medium"
            android:hint="Nome da ONG"
            android:padding="12dp"/>

        <!-- CNPJ -->
        <EditText
            android:id="@+id/etCnpj"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#E0FFED"
            android:fontFamily="sans-serif-medium"
            android:hint="CNPJ"
            android:inputType="number"
            android:padding="12dp"/>

        <!-- Email -->
        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#E0FFED"
            android:fontFamily="sans-serif-medium"
            android:hint="Email"
            android:inputType="textEmailAddress"
            android:padding="12dp"/>

        <!-- Senha -->
        <EditText
            android:id="@+id/etSenha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#E0FFED"
            android:fontFamily="sans-serif-medium"
            android:hint="Senha"
            android:inputType="textPassword"
            android:padding="12dp"/>

        <!-- Estado -->
        <EditText
            android:id="@+id/etEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#E0FFED"
            android:fontFamily="sans-serif-medium"
            android:hint="Digite o seu estado (exemplo: SP)"
            android:inputType="text"
            android:padding="12dp"/>

        <!-- CEP -->
        <EditText
            android:id="@+id/etCep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#E0FFED"
            android:fontFamily="sans-serif-medium"
            android:hint="CEP"
            android:inputType="number"
            android:padding="12dp"/>

        <!-- Cidade -->
        <EditText
            android:id="@+id/etCidade"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#E0FFED"
            android:fontFamily="sans-serif-medium"
            android:hint="Cidade"
            android:padding="12dp"/>

        <!-- Endereço -->
        <EditText
            android:id="@+id/etEndereco"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#E0FFED"
            android:fontFamily="sans-serif-medium"
            android:hint="Endereço"
            android:padding="12dp"/>

        <!-- Botão -->
        <Button
            android:id="@+id/btnCadastrarOng"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="#498933"
            android:text="Cadastrar ONG"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif"/>

    </LinearLayout>

</ScrollView>