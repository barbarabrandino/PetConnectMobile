<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_page"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header verde -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/verdebtn"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="32dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- Botão voltar -->
            <ImageView
                android:id="@+id/btnVoltar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginBottom="12dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/white"
                android:background="@drawable/circle_white_20_alpha"
                android:padding="6dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Voltar" />

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/circle_white_20_alpha">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_paw"
                    android:tint="@color/white" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/albert_sans_light"
                android:text="Cadastrar ONG"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/albert_sans_light"
                android:text="Preencha os dados da sua organização"
                android:textColor="#BDFFF0"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Corpo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <!-- SEÇÃO: DADOS DA ONG -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/albert_sans_light"
                    android:text="DADOS DA ONG"
                    android:textAllCaps="true"
                    android:textColor="@color/verdebtn"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0.5dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@color/divider_color" />
            </LinearLayout>

            <!-- Nome da ONG -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/albert_sans_light"
                android:text="NOME DA ONG"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/field_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_user"
                    android:tint="@color/text_tertiary" />

                <EditText
                    android:id="@+id/etNomeOng"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/albert_sans_light"
                    android:hint="Nome da organização"
                    android:inputType="textCapWords"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- CNPJ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/albert_sans_light"
                android:text="CNPJ"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/field_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_id_badge"
                    android:tint="@color/text_tertiary" />

                <EditText
                    android:id="@+id/etCnpj"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/albert_sans_light"
                    android:hint="00.000.000/0000-00"
                    android:inputType="number"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- SEÇÃO: ACESSO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/albert_sans_light"
                    android:text="ACESSO"
                    android:textAllCaps="true"
                    android:textColor="@color/verdebtn"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0.5dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@color/divider_color" />
            </LinearLayout>

            <!-- Email -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/albert_sans_light"
                android:text="EMAIL"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/field_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_mail"
                    android:tint="@color/text_tertiary" />

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/albert_sans_light"
                    android:hint="contato@ong.org.br"
                    android:inputType="textEmailAddress"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Senha -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/albert_sans_light"
                android:text="SENHA"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/field_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_lock"
                    android:tint="@color/text_tertiary" />

                <EditText
                    android:id="@+id/etSenha"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/albert_sans_light"
                    android:hint="Mínimo 6 caracteres"
                    android:inputType="textPassword"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- SEÇÃO: ENDEREÇO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/albert_sans_light"
                    android:text="ENDEREÇO"
                    android:textAllCaps="true"
                    android:textColor="@color/verdebtn"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0.5dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:background="@color/divider_color" />
            </LinearLayout>

            <!-- CEP + Estado lado a lado -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp"
                android:weightSum="2">

                <!-- CEP -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/albert_sans_light"
                        android:text="CEP"
                        android:textAllCaps="true"
                        android:textColor="@color/black"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/field_background"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_map_pin"
                            android:tint="@color/text_tertiary" />

                        <EditText
                            android:id="@+id/etCep"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:fontFamily="@font/albert_sans_light"
                            android:hint="00000-000"
                            android:inputType="number"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Estado -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/albert_sans_light"
                        android:text="ESTADO"
                        android:textAllCaps="true"
                        android:textColor="@color/black"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/field_background"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="10dp"
                        android:paddingEnd="4dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_map"
                            android:tint="@color/text_tertiary" />

                        <EditText
                            android:id="@+id/etEstado"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:fontFamily="@font/albert_sans_light"
                            android:hint="UF"
                            android:inputType="textCapCharacters"
                            android:maxLength="2"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Cidade -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/albert_sans_light"
                android:text="CIDADE"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/field_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_building"
                    android:tint="@color/text_tertiary" />

                <EditText
                    android:id="@+id/etCidade"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/albert_sans_light"
                    android:hint="Sua cidade"
                    android:inputType="textCapWords"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Endereço -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/albert_sans_light"
                android:text="ENDEREÇO"
                android:textAllCaps="true"
                android:textColor="@color/black"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/field_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_home"
                    android:tint="@color/text_tertiary" />

                <EditText
                    android:id="@+id/etEndereco"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/albert_sans_light"
                    android:hint="Rua, número, bairro"
                    android:inputType="textPostalAddress"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Botão -->
            <Button
                android:id="@+id/btnCadastrarOng"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="@color/verdebtn"
                android:fontFamily="@font/albert_sans_light"
                android:text="Cadastrar ONG"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/albert_sans_light"
                android:text="Já tem uma conta?"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/albert_sans_light"
                android:text="Entrar"
                android:textColor="@color/verdebtn"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>
    </LinearLayout>

</ScrollView>