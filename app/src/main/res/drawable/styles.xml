<resources>

    <!-- Tema base do app -->
    <style name="Theme.PetConnect" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">#3AAFA9</item>
        <item name="colorPrimaryDark">#2C9E98</item>
        <item name="colorAccent">#2C3E50</item>
        <item name="android:windowBackground">#F5F5F5</item>
    </style>

    <!-- Estilo das tags (Vacinado, Médio, Castrado) -->
    <style name="tagStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_tag</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">#2C3E50</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
